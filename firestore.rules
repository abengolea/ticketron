/**
 * @file Firebase Security Rules for Ticketron Application
 * @corePhilosophy This ruleset prioritizes security and scalability for the Ticketron application.
 *   It eliminates the need for `get()` calls in security rules and ensures atomic operations.
 *   Rules are not filters.
 * @dataStructure The structure is segregated into two main collections: `events` and `tickets`.
 *   Events store event-specific data. Tickets are stored under the `tickets` collection,
 *   including the denormalized `eventId` for efficient querying and authorization.
 * @keySecurityDecisions
 *   - No public listing of tickets.
 *   - Events can be created by any signed-in user.
 *   - Tickets can be created by any signed-in user.
 *   - Read access to events and tickets is public.
 * @denormalizationForAuthorization The `tickets` collection denormalizes `eventId` from the `events` collection
 *   to enable efficient authorization checks without requiring `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /events/{eventId} collection.
     * @path /databases/{database}/documents/events/{eventId}
     * @allow (get, list) Allow any user to read events.
     * @allow (create) Allow any signed-in user to create an event.
     * @deny (update, delete) Deny updates and deletes to all users.
     * @principle Allows public read access to events while restricting modifications.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Controls access to the /tickets/{ticketId} collection.
     * @path /databases/{database}/documents/tickets/{ticketId}
     * @allow (get) Allow any user to read ticket.
     * @allow (create) Allow any signed-in user to create a ticket.
     * @deny (list, update, delete) Deny listing, updating, and deleting tickets to all users.
     * @principle Restricts listing and modifications of tickets.
     */
    match /tickets/{ticketId} {
      allow get: if true;
      allow create: if isSignedIn();
      allow list, update, delete: if false;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}