/**
 * @file Firebase Security Rules for Ticketron Application
 *
 * Core Philosophy:
 * This ruleset enforces a secure model for managing events and tickets.
 * All write operations are restricted. Read permissions on the `tickets` collection are public.
 *
 * Data Structure:
 * - /events/{eventId}: Stores event details.
 * - /tickets/{ticketId}: Stores ticket information, including a denormalized eventId.
 *
 * Key Security Decisions:
 * - No user-specific data trees: This design intentionally avoids nesting data under user IDs.
 * - `secretKey` is NOT stored within the `tickets` document for enhanced security.
 * - Public listing for the `tickets` collection is enabled since all validation data is contained in the ticket itself.
 *
 * Denormalization for Authorization:
 * - The `eventId` is denormalized onto each `ticket` document. This avoids costly `get()` calls to the `/events/{eventId}` document during ticket validation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for the /events/{eventId} collection. Only allow read for now.
     * @path /events/{eventId}
     * @allow get: if true;
     * @allow list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Restricts write operations to events collection.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /tickets/{ticketId} collection.
     * @path /tickets/{ticketId}
     * @allow get: if true;
     * @allow list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows public read access to ticket data.
     */
    match /tickets/{ticketId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}