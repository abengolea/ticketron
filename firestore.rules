/**
 * @fileoverview Firestore Security Rules for Ticketron.
 *
 * Core Philosophy: This ruleset prioritizes security and scalability for ticket generation and validation. It enforces strict data segregation and authorization independence, eliminating the need for `get()` calls in security rules. Access is generally open for reads, with restricted write operations to protect data integrity, assuming a trusted backend manages data modifications.
 *
 * Data Structure: The data is organized into two top-level collections:
 *   - /events/{eventId}: Stores event details, including the secretKey (used offline).
 *   - /tickets/{ticketId}: Stores ticket information, including a denormalized eventId.
 *
 * Key Security Decisions:
 *   - Public read access to both /events and /tickets collections.
 *   - Event and ticket creation is assumed to be handled by trusted backend logic and is not directly controlled by these rules.
 *   - Authorization Independence: All necessary data for ticket validation is stored within the ticket document itself (except for the secretKey, which is handled offline).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to event data. Assumes event creation and management are handled by a trusted backend.
     * @path /events/{eventId}
     * @allow (get, list) Any user can read event data.
     * @deny (create, update, delete) No user can create, update, or delete events through direct Firestore writes.
     * @principle Public read access with backend-managed writes.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to ticket data. Assumes ticket creation and management are handled by a trusted backend.
     * @path /tickets/{ticketId}
     * @allow (get, list) Any user can read ticket data.
     * @deny (create, update, delete) No user can create, update, or delete tickets through direct Firestore writes.
     * @principle Public read access with backend-managed writes.
     */
    match /tickets/{ticketId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}