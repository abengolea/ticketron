/**
 * @fileoverview Firestore Security Rules for Ticketron.
 *
 * Core Philosophy:
 * This ruleset enforces a flexible data model that prioritizes security through authorization independence.
 * It explicitly avoids `get()` calls in rules for performance and cost efficiency.
 * Read access to both collections is public, while write access is denied to all.
 *
 * Data Structure:
 * The database consists of two top-level collections: `events` and `tickets`.
 * - `/events/{eventId}`: Stores event metadata, including the secret key.
 * - `/tickets/{ticketId}`: Stores individual ticket information, including a denormalized `eventId`.
 *
 * Key Security Decisions:
 * - Public Read Access: Both `events` and `tickets` collections are publicly readable to allow for rapid prototyping and data discovery.
 * - No Write Access: All write operations (create, update, delete) are denied to all users. This is a prototype that prioritizes the ticket generation and offline validation functionalities. This ensures that no data can be modified through direct client interaction.
 * - Authorization Independence: No `get()` calls are used in the security rules, avoiding complex lookups and dependencies. All data necessary for authorization should be present within the document itself.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to event documents, but denies all write operations.
     * @path /events/{eventId}
     * @allow get, list: Everyone can read event details.
     * @deny create, update, delete: No one can create, update, or delete events directly.
     * @principle Allows public read access and no client-side writes.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to ticket documents, but denies all write operations.
     * @path /tickets/{ticketId}
     * @allow get, list: Everyone can read ticket details.
     * @deny create, update, delete: No one can create, update, or delete tickets directly.
     * @principle Allows public read access and no client-side writes.
     */
    match /tickets/{ticketId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}