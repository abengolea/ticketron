/**
 * @fileoverview Firestore Security Rules for Ticketron.
 *
 * Core Philosophy:
 * This ruleset prioritizes security and scalability, focusing on authorization independence to eliminate the need for `get()` calls.
 * The rules are designed to support anonymous ticket generation and secure `list` operations.
 *
 * Data Structure:
 * The data is structured into two top-level collections: `events` and `tickets`.
 * - `/events/{eventId}`: Stores event details, including the event name, date, time, venue, and the `secretKey` used for generating ticket signatures.
 * - `/tickets/{ticketId}`: Stores ticket information, including a denormalized `eventId` for efficient querying.
 *
 * Key Security Decisions:
 * - Authorization independence is achieved by ensuring all data needed for ticket validation (except the secretKey) is stored directly within the `ticket` document.
 * - The `secretKey` is intentionally NOT stored in the `ticket` document and is handled separately on the backend.
 * - Public `list` operations are generally disallowed for collections containing sensitive user data. Instead, filtering is used to control data access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to event documents.
     * @path /events/{eventId}
     * @allow (create) - Allowed for authorized users to create events. Authorization details not defined in current scope.
     * @deny (create) - Denied for unauthorized users.
     */
    match /events/{eventId} {
      // Placeholder rule.  Create requires custom authorization logic (e.g., checking admin role).
      allow get, list: if false;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages access to ticket documents.
     * @path /tickets/{ticketId}
     * @allow (create) - Allowed for authorized users to create tickets. Authorization details not defined in current scope.
     * @deny (create) - Denied for unauthorized users.
     */
    match /tickets/{ticketId} {
      // Placeholder rule.  Create requires custom authorization logic (e.g., checking admin role).
      allow get, list: if false;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}