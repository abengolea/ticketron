/**
 * @description This ruleset enforces a strict user-ownership model for event secrets and allows public read access to events and tickets.
 *
 * Data Structure:
 * - /events/{eventId}: Stores event details, publicly readable.
 * - /tickets/{ticketId}: Stores ticket information, publicly readable.
 * - /event_secrets/{eventId}: Stores the event's secret key, accessible only to the event owner.
 *
 * Key Security Decisions:
 * - Events and tickets are publicly readable, but only the owner can modify or delete them.
 * - Event secrets are strictly controlled, with owner-only access for creation, updates, and deletion.
 * - No user listing is allowed for event secrets.
 *
 * Denormalization for Authorization:
 * - The `event_secrets` document includes an `ownerId` field, allowing for direct ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to event details. Only the event owner can create, update, or delete events.
     * @path /events/{eventId}
     * @allow (get, list): Any user can read event details.
     * @allow (create): The event owner can create an event if `request.resource.data.ownerId` matches their `auth.uid`.
     * @allow (update, delete): Only the event owner can update or delete an event.
     * @deny (create): A user cannot create an event if `request.resource.data.ownerId` does not match their `auth.uid`.
     * @deny (update, delete): A non-owner cannot update or delete an event.
     * @principle Public read, owner-only writes, enforces document ownership for writes.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Allows public read access to ticket information. Only the ticket owner can create, update, or delete tickets.
     * @path /tickets/{ticketId}
     * @allow (get, list): Any user can read ticket information.
     * @allow (create): The ticket owner can create a ticket if `request.resource.data.ownerId` matches their `auth.uid`.
     * @allow (update, delete): Only the ticket owner can update or delete a ticket.
     * @deny (create): A user cannot create a ticket if `request.resource.data.ownerId` does not match their `auth.uid`.
     * @deny (update, delete): A non-owner cannot update or delete a ticket.
     * @principle Public read, owner-only writes, enforces document ownership for writes.
     */
    match /tickets/{ticketId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

        /**
     * @description Manages event secrets, restricting access to only the owner of the event.
     * @path /event_secrets/{eventId}
     * @allow (create): Allows the event owner to create a new secret. Requires the `ownerId` to match the authenticated user's UID.
     * @allow (update, delete): Only the event owner can update or delete the event secret.
     * @deny (create): Denies creation if the `ownerId` does not match the authenticated user's UID.
     * @deny (get, list): Prevents unauthorized access to event secrets by denying get and list operations.
     * @deny (update, delete): Denies modification or deletion of the secret by non-owners.
     * @principle Owner-only access, enforces strict document ownership.
     */
    match /event_secrets/{eventId} {
      allow get, list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && isExistingOwner(resource.data.ownerId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}