rules_version = '2';

/**
 * Ticketron — Reglas de seguridad Firestore
 *
 * Operaciones sensibles vía Firebase Admin SDK en server actions.
 *
 * Primer superadmin: scripts/bootstrap-superadmin.ts
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.active == true;
    }

    function hasRole(role) {
      return isActiveUser() && userDoc().data.role == role;
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function isProducer() {
      return hasRole('producer');
    }

    function canManageEvents() {
      return isSuperAdmin() || isProducer();
    }

    function isSeller() {
      return hasRole('seller');
    }

    function isGate() {
      return hasRole('gate') || canManageEvents();
    }

    function isBuyer() {
      return hasRole('buyer');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if canManageEvents() || isSuperAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /sellerEventAccess/{accessId} {
      allow read: if canManageEvents();
      allow read: if isSeller() && resource.data.sellerId == request.auth.uid;
      allow write: if false;
    }

    match /paymentLinks/{linkId} {
      allow read: if canManageEvents();
      allow read: if isSeller() && resource.data.sellerId == request.auth.uid;
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if canManageEvents() || isGate();
      allow write: if false;
    }

    match /buyerActivationTokens/{tokenId} {
      allow read, write: if false;
    }

    match /barProducts/{productId} {
      allow read, write: if false;
    }

    match /barOrders/{orderId} {
      allow read, write: if false;
    }
  }
}
