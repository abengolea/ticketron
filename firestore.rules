/**
 * @file Overview
 * This ruleset enforces a public-read, owner-write model for 'events' and restricts 'tickets' access.
 *
 * Data Structure:
 * - /events/{eventId}: Stores event details.
 * - /tickets/{ticketId}: Stores ticket information, including a denormalized eventId.
 *
 * Key Security Decisions:
 * - Events are publicly readable, but only authorized users (currently, all signed-in users) can create, update, or delete them.
 * - Tickets can be created by any signed-in user, but this should later be changed to event-specific authorization.
 * - Data validation is minimal, focusing on relational integrity rather than full schema enforcement.
 *
 * Denormalization for Authorization:
 * - The 'tickets' collection denormalizes the 'eventId' from the 'events' collection to enable efficient queries. The secretKey is not stored in the tickets collection to protect its value.
 *
 * Structural Segregation:
 * - The data is segregated into 'events' and 'tickets' collections to allow for independent management and scaling.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to events, but restricts writes to signed-in users.
     * @path /events/{eventId}
     * @allow (get, list): Any user can read event data.
     * @allow (create): Any signed-in user can create a new event.
     * @allow (update, delete): Only the user who created the event can modify or delete it.
     * @deny (create): An unauthenticated user attempts to create an event.
     * @deny (update): An unauthenticated user attempts to update an event.
     * @deny (delete): An unauthenticated user attempts to delete an event.
     * @principle Allows public reads while restricting writes to authorized users.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows any signed-in user to create tickets.  Future security measures should validate event existence.
     * @path /tickets/{ticketId}
     * @allow (create): Any signed-in user can create a new ticket.
     * @deny (create): An unauthenticated user attempts to create a ticket.
     * @principle: Allows public reads while restricting writes to authorized users.
     */
    match /tickets/{ticketId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}