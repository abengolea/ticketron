/**
 * @file Firebase Security Rules for Ticketron Application
 *
 * @description
 * This ruleset enforces a security model that allows public read access to both events and tickets,
 * but restricts create, update, and delete operations to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /events/{eventId}: Stores event details (name, date, time, venue, secretKey).
 * - /tickets/{ticketId}: Stores ticket information, including a reference to the eventId.
 *
 * Key Security Decisions:
 * - Public read access is enabled for both events and tickets to allow for open discovery.
 * - All write operations (create, update, delete) are denied to prevent unauthorized data modification,
 *   as the authorization logic for ticket generation is handled on the backend using a separate secretKey file.
 * - List operations are allowed for both events and tickets, as there are no specific listing restrictions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to event details, but restricts all write operations.
     * @path /events/{eventId}
     * @allow (get, list) - Any user can read event details.
     * @deny (create, update, delete) - No user can create, update, or delete events through Firestore.
     * @principle Public read with restricted writes.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to ticket information, but restricts all write operations.
     * @path /tickets/{ticketId}
     * @allow (get, list) - Any user can read ticket information.
     * @deny (create, update, delete) - No user can create, update, or delete tickets through Firestore.
     * @principle Public read with restricted writes.
     */
    match /tickets/{ticketId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}